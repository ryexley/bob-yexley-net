{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "ignorePatterns": ["**/build/**", "**/.output/**", "**/node_modules/**"],
  "plugins": ["typescript", "unicorn", "import"],
  "jsPlugins": [
    {
      "name": "solid",
      "specifier": "oxlint-plugin-solidjs"
    }
  ],
  "env": {
    "browser": true,
    "node": true
  },
  "categories": {
    "correctness": "warn"
  },
  "rules": {
    "curly": ["error", "all"],
    "no-unused-vars": [
      "warn",
      {
        "args": "none",
        "vars": "all",
        "caughtErrors": "all"
      }
    ],
    "eslint/no-unassigned-vars": "off",
    "unicorn/filename-case": [
      "error",
      {
        "case": "kebabCase"
      }
    ],
    "solid/jsx-no-duplicate-props": "error",
    "solid/jsx-no-undef": "error",
    "solid/jsx-uses-vars": "error",
    "solid/no-unknown-namespaces": "error",
    "solid/no-innerhtml": "error",
    "solid/jsx-no-script-url": "error",
    "solid/components-return-once": "warn",
    "solid/no-destructure": "error",
    "solid/prefer-for": "error",
    "solid/reactivity": "warn",
    "solid/event-handlers": "warn",
    "solid/imports": "warn",
    "solid/style-prop": "warn",
    "solid/no-react-deps": "warn",
    "solid/no-react-specific-props": "warn",
    "solid/self-closing-comp": "warn",
    "solid/no-array-handlers": "off",
    "solid/prefer-show": "off",
    "solid/no-proxy-apis": "off",
    "solid/prefer-classlist": "off"
  },
  "overrides": [
    {
      "files": ["**/*.spec.ts", "**/*.spec.tsx"],
      "rules": {
        "solid/reactivity": "off",
        "solid/components-return-once": "off",
        "unicorn/no-thenable": "off"
      }
    }
  ]
}
