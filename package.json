{
  "name": "bob.yexley.net",
  "description": "my personal web site",
  "version": "0.45.6",
  "type": "module",
  "scripts": {
    "refresh": "rm -rf node_modules && rm -f pnpm-lock.yaml && pnpm install",
    "compile": "tsc",
    "lint": "oxlint src/",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "test": "vitest run",
    "test:watch": "vitest",
    "quality-check": "concurrently --kill-others-on-fail --names \"tsc,oxlint\" --prefix-colors \"auto,auto\" \"pnpm compile\" \"pnpm lint\" --color",
    "qc": "pnpm quality-check",
    "db:start": "pnpm exec supabase start",
    "db:stop": "pnpm exec supabase stop",
    "db:status": "pnpm exec supabase status",
    "db:reset": "pnpm exec supabase db reset",
    "db:pull": "pnpm exec supabase db pull",
    "db:push:local": "pnpm exec supabase db push --local",
    "db:push:remote": "pnpm exec supabase db push --linked",
    "db:diff": "pnpm exec supabase db diff",
    "db:migration:new": "pnpm exec supabase migration new",
    "db:migration:list": "pnpm exec supabase migration list",
    "db:types": "mkdir -p src/types && pnpm exec supabase gen types typescript --local > src/types/database.types.ts",
    "db:bootstrap:superuser": "node ./scripts/bootstrap-local-superuser.mjs",
    "db:bootstrap:visitors": "node ./scripts/bootstrap-local-fixtures.mjs --mode=visitors",
    "db:bootstrap:fixtures": "node ./scripts/bootstrap-local-fixtures.mjs --mode=all",
    "db:reset:fixtures": "pnpm db:reset && pnpm db:bootstrap:fixtures",
    "dev": "node --env-file=.env.local ./node_modules/vite/bin/vite.js dev --port 7808 --host",
    "dev:app": "node --env-file=.env.local ./node_modules/vite/bin/vite.js dev --port 7808 --host",
    "dev:local": "node --env-file=.env.local ./node_modules/vite/bin/vite.js dev --port 7808 --host",
    "build": "vite build",
    "start": "node --env-file=.env.local .output/server/index.mjs",
    "preview": "vite preview --port 7808 --host",
    "component:add": "pnpm dlx shadcn-solid add"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1073.0",
    "@aws-sdk/s3-request-presigner": "^3.1073.0",
    "@cookbook/solid-intl": "^0.1.3",
    "@corvu/drawer": "^0.2.4",
    "@formatjs/intl": "^4.1.2",
    "@kobalte/core": "^0.13.13",
    "@milkdown/core": "^7.19.0",
    "@milkdown/plugin-emoji": "^7.19.0",
    "@milkdown/plugin-listener": "^7.19.0",
    "@milkdown/plugin-slash": "^7.19.0",
    "@milkdown/preset-commonmark": "^7.19.0",
    "@milkdown/prose": "^7.19.0",
    "@milkdown/theme-nord": "^7.19.0",
    "@milkdown/utils": "^7.19.0",
    "@solidjs/meta": "^0.29.4",
    "@solidjs/router": "^1.0.0",
    "@solidjs/start": "^2.0.4",
    "@supabase/ssr": "^0.12.6",
    "@supabase/supabase-js": "^2.115.0",
    "@unpic/solid": "^1.0.0",
    "@uppy/aws-s3": "^5.1.0",
    "@uppy/core": "^5.2.0",
    "chart.js": "^4.5.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "exifr": "^7.1.3",
    "fontfaceobserver": "^2.3.0",
    "heic-convert": "^2.1.0",
    "marked": "^17.0.3",
    "micromark-extension-mark": "^1.0.2",
    "nitro": "3.0.260903-beta",
    "sharp": "^0.35.2",
    "solid-js": "^1.9.15",
    "solid-transition-group": "^0.3.0",
    "tailwind-merge": "^3.3.1",
    "ua-parser-js": "^2.0.10",
    "vite": "^8.2.2",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@corvu/tailwind": "^0.1.7",
    "@kobalte/tailwindcss": "^0.9.0",
    "@solidjs/testing-library": "^0.8.10",
    "@tailwindcss/vite": "^4.1.10",
    "@testing-library/user-event": "^14.6.1",
    "@types/heic-convert": "^2.1.1",
    "@types/node": "^26.0.0",
    "@types/ua-parser-js": "^0.7.39",
    "concurrently": "^9.1.2",
    "jsdom": "^29.0.1",
    "oxlint-plugin-solidjs": "^0.1.1",
    "oxfmt": "^0.66.0",
    "oxlint": "^1.81.0",
    "supabase": "^2.116.0",
    "tailwindcss": "^4.1.10",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^5.8.3",
    "vite-plugin-solid": "^2.11.14",
    "vitest": "^4.1.2"
  },
  "engines": {
    "node": ">=24"
  }
}
